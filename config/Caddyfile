{
	admin off
	auto_https disable_redirects
}

(backends) {
	# Not the camera: gzip buffers the endless MJPEG stream.
	@compressible not path /cam/*
	encode @compressible gzip

	handle /api/* {
		uri strip_prefix /api
		reverse_proxy 127.0.0.1:8000
	}

	handle /node/* {
		uri strip_prefix /node
		reverse_proxy 127.0.0.1:3000
	}

	handle /admin/* {
		basic_auth {
			admin {$ADMIN_PASSWORD_HASH}
		}
		uri strip_prefix /admin
		reverse_proxy 127.0.0.1:9000
	}

	# Camera: cam-gate login (cookie) first, then IP Webcam's own password.
	handle /cam-login* {
		reverse_proxy 127.0.0.1:9100
	}

	redir /cam /cam/
	handle /cam/* {
		# route keeps this order; otherwise uri runs before forward_auth and
		# cam-gate never sees the original /cam/... path for its redirect.
		route {
			forward_auth 127.0.0.1:9100 {
				uri /auth
			}
			# Viewer page with the camera switch lives in cam-gate.
			reverse_proxy /cam/view 127.0.0.1:9100
			uri strip_prefix /cam
			# Send each video frame as it arrives instead of buffering.
			reverse_proxy 127.0.0.1:27461 {
				flush_interval -1
			}
		}
	}

	@healthcheck path /health /health/*
	handle @healthcheck {
		reverse_proxy 127.0.0.1:3100
	}

	handle {
		root * /data/data/com.termux/files/home/nova3i/webroot
		file_server
	}
}

http://127.0.0.1:8080 {
	import backends
}

https://nova3i.taila5f58b.ts.net:8443 {
	tls /data/data/com.termux/files/home/nova3i/config/ts.crt /data/data/com.termux/files/home/nova3i/config/ts.key
	import backends
}

https://nova3i.jamilur.com:8443 {
	tls /data/data/com.termux/files/home/nova3i/config/site.crt /data/data/com.termux/files/home/nova3i/config/site.key
	import backends
}
